# Base URL of the API. Both login and the provider search read this.
# Android emulator default for providers: http://10.0.2.2:8787, iOS simulator/web: http://localhost:8787.
# On a PHYSICAL PHONE, localhost does not work: use your computer's LAN IP and start the API with
# `npm run dev:lan` (apps/api), which serves on all interfaces. Allow it through Windows Firewall if asked.
# Or point this at the deployed Worker URL.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8787
