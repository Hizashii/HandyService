{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-15",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "helpdk",
      "database_id": "00d8955e-cde2-4553-a754-d797a9308b80",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Comma-separated ISO country codes the /api/geocode endpoint is limited to.
    "GEOCODE_COUNTRIES": "dk"
  }
