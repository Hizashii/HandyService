{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-15",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "handyservice",
      // Placeholder: replace with the id printed by `npx wrangler d1 create handyservice`
      // before deploying. Local `wrangler dev` does not need a real id.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Comma-separated ISO country codes the /geocode endpoint is limited to.
    "GEOCODE_COUNTRIES": "dk"
  },
  "observability": {
    "enabled": true
  }
}
